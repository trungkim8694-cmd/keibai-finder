generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Property {
  sale_unit_id         String            @id
  source_provider      String            @default("BIT")
  source_url           String?
  court_name           String
  property_type        String
  address              String
  prefecture           String?
  city                 String?
  lat                  Float?
  lng                  Float?
  starting_price       BigInt?
  status               String            @default("ACTIVE")
  views                Int               @default(dbgenerated("(floor(((random() * (601)::double precision) + (200)::double precision)))::integer"))
  thumbnailUrl         String?
  pdf_url              String?
  raw_display_data     Json?
  raw_text             String?
  ai_analysis          Json?
  ai_status            String?           @default("PENDING_AI")
  build_year_western   Int?
  images               String[]
  area                 Float?
  bid_start_date       DateTime?
  bid_end_date         DateTime?
  managing_authority   String?
  line_name            String?
  nearest_station      String?
  distance_to_station  Int?
  walk_time_to_station Int?
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  mlit_estimated_price BigInt?
  mlit_investment_gap  Float?
  auction_history      AuctionHistory[]
  auction_events       AuctionSchedule[]

  @@index([lat, lng])
  @@index([prefecture])
  @@index([area])
  @@index([bid_start_date])
  @@index([bid_end_date])
  @@index([line_name])
  @@index([nearest_station])
  @@index([walk_time_to_station])
  @@index([managing_authority])
  @@index([views])
  @@index([created_at])
  @@index([mlit_investment_gap], map: "idx_property_mlit_gap")
  @@index([status, source_provider])
  @@index([status, property_type], map: "idx_property_status_type")
  @@index([status, starting_price], map: "idx_property_status_price")
  @@index([status, prefecture, city], map: "idx_property_status_pref_city")
  @@index([status, source_provider, court_name], map: "idx_property_status_prov_court")
  @@index([status, created_at(sort: Desc)], map: "idx_property_status_created_desc")
  @@index([status, mlit_investment_gap(sort: Desc)], map: "idx_property_status_gap_desc")
  @@index([status, bid_end_date], map: "idx_property_status_bid_end")
}

model AuctionHistory {
  id            String   @id @default(uuid())
  sale_unit_id  String
  price         BigInt?
  round_name    String?
  drop_percent  Float?
  discovered_at DateTime @default(now())
  property      Property @relation(fields: [sale_unit_id], references: [sale_unit_id], onDelete: Cascade)
}

model AuctionSchedule {
  id             String    @id @default(uuid())
  sale_unit_id   String
  bid_start_date DateTime?
  bid_end_date   DateTime?
  open_date      DateTime?
  property       Property  @relation(fields: [sale_unit_id], references: [sale_unit_id], onDelete: Cascade)
}

model AuctionResult {
  id               String    @id @default(uuid())
  sale_unit_id     String?   @unique
  caseNumber       String
  address          String?
  prefecture       String?
  lat              Float?
  lng              Float?
  basePrice        BigInt?
  winningPrice     BigInt?
  bidderCount      Int?
  winnerType       String?
  marginRate       Float?
  competitionLevel String?
  completionDate   DateTime?
  raw_data         Json?
  created_at       DateTime  @default(now())

  @@index([prefecture])
  @@index([lat, lng])
  @@index([completionDate(sort: Desc)], map: "idx_auction_result_completion_desc")
  @@index([competitionLevel], map: "idx_auction_result_comp_level")
}

model RailwayStation {
  id         String   @id @default(uuid())
  name_ja    String
  line_name  String?
  lat        Float
  lng        Float
  created_at DateTime @default(now())

  @@index([lat, lng])
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  role          String     @default("USER")
  isBanned      Boolean    @default(false)
  adminNotes    String?    @db.Text
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  accounts      Account[]
  comments      Comment[]
  favorites     Favorite[]
  sessions      Session[]
  memos         UserMemo[]

  agencyProfile    AgencyProfile?
  agencyReviews    AgencyReview[]
  agencyReports    AgencyReport[]
  claimedCompanies RealEstateCompany[]
  claimRequests    CompanyClaimRequest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuthOtpToken {
  id           String    @id @default(cuid())
  email        String    @unique
  otpCode      String?
  otpExpires   DateTime?
  token        String?   @unique
  tokenExpires DateTime?
  attempts     Int       @default(0)
  lastSentAt   DateTime  @default(now())
  created_at   DateTime  @default(now())

  @@index([email])
  @@index([token])
}

model Favorite {
  id           String   @id @default(cuid())
  userId       String
  sale_unit_id String
  stage        String   @default("CONSIDERING") // CONSIDERING, INSPECTED, BID_PREPARING, BID_SUBMITTED, SKIPPED
  created_at   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sale_unit_id])
}

model UserMemo {
  id           String   @id @default(cuid())
  userId       String
  sale_unit_id String
  content      String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sale_unit_id])
}

model Comment {
  id           String   @id @default(cuid())
  userId       String
  sale_unit_id String
  content      String
  created_at   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MlitMarketCache {
  id               String   @id @default(cuid())
  municipalityCode String
  propertyType     String
  year             String
  avgTradePrice    BigInt?
  avgPricePerSqm   BigInt?
  avgArea          Float?
  transactions     Json?
  last_fetched_at  DateTime @default(now())

  @@unique([municipalityCode, propertyType, year])
  @@index([municipalityCode])
}

model DailyDigest {
  id             String    @id @default(cuid())
  slug           String    @unique
  publishDate    DateTime  @default(now())
  
  // SEO Metadata
  title_ja       String
  title_en       String
  title_vi       String
  title_zh       String
  
  // Cấu trúc Content phân mảnh (Lưu Markdown)
  content_ja     String    @db.Text
  content_en     String    @db.Text
  content_vi     String    @db.Text
  content_zh     String    @db.Text
  
  category       String    @default("MARKET_REPORT") // New field: MARKET_REPORT, GUIDE, CAUTION

  // Dữ liệu dùng dể Render React Shortcode và SEO Internal link
  tags           String[]  // ['saitama', 'tokyo', 'mansion']
  featuredImage  String?   // Ảnh Cover
  
  previousSlugs  String[]  @default([])
  
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  
  @@index([publishDate])
  @@index([slug])
}

model Redirect {
  id         String   @id @default(cuid())
  oldPath    String   @unique
  newPath    String
  statusCode Int      @default(301)
  created_at DateTime @default(now())

  @@index([oldPath])
}

model AgencyProfile {
  id            String         @id @default(cuid())
  userId        String         @unique
  companyName   String
  licenseNumber String
  phone         String
  fax           String?
  email         String?
  website       String?
  prefectures   String[]
  description   String?        @db.Text
  logoUrl       String?
  licenseImageUrl String?
  isVerified    Boolean        @default(true)
  rejectionReason String?      @db.Text
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews       AgencyReview[]
  reports       AgencyReport[]
}

model AgencyReview {
  id              String        @id @default(cuid())
  agencyProfileId String
  userId          String
  rating          Int
  comment         String        @db.Text
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  agency          AgencyProfile @relation(fields: [agencyProfileId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyProfileId, userId])
}

model AgencyReport {
  id              String        @id @default(cuid())
  agencyProfileId String
  userId          String
  reason          String        @db.Text
  created_at      DateTime      @default(now())

  agency          AgencyProfile @relation(fields: [agencyProfileId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgencyLead {
  id                   String   @id @default(cuid())
  sale_unit_id         String?
  agencyProfileId      String?
  customerName         String
  contactMethod        String   @default("PHONE")
  contactValue         String
  inquiryType          String   @default("BIDDING_ASSIST")
  message              String?  @db.Text
  dispatchedCompanyIds String[] @default([])
  partnerNotes         String?  @db.Text
  status               String   @default("NEW") // NEW, CONTACTED, IN_CONSULTATION, WON, CLOSED
  created_at           DateTime @default(now())

  @@index([sale_unit_id])
  @@index([agencyProfileId])
  @@index([created_at])
}

model RealEstateCompany {
  id              String   @id @default(cuid())
  houjinNumber    String?  @unique
  companyName     String
  licenseNumber   String
  prefecture      String
  city            String
  address         String
  postalCode      String?
  phone           String?
  fax             String?
  email           String?
  website         String?
  logoUrl         String?
  description     String?  @db.Text
  isClaimed       Boolean  @default(false)
  isVerified      Boolean  @default(false)
  claimedUserId   String?
  specialties     String[]
  status          String   @default("ACTIVE") // ACTIVE, DELISTED, PENDING_REVIEW
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  claimedUser     User?    @relation(fields: [claimedUserId], references: [id], onDelete: SetNull)
  claimRequests   CompanyClaimRequest[]
  delistRequests  CompanyDelistRequest[]

  @@index([prefecture, city])
  @@index([status])
  @@index([isVerified])
  @@index([isClaimed])
  @@index([companyName])
  @@index([prefecture, status])
}

model CompanyClaimRequest {
  id                 String   @id @default(cuid())
  companyId          String
  applicantName      String
  applicantEmail     String
  applicantPhone     String
  position           String
  corporateEmail     String?
  verificationMethod String   @default("EMAIL_DOMAIN") // EMAIL_DOMAIN, DOCUMENT
  documentUrl        String?
  documentType       String?  // TOHON, MEISHI, TAKKEN_LICENSE, OTHER
  notes              String?  @db.Text
  status             String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason    String?  @db.Text
  reviewedAt         DateTime?
  userId             String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  company         RealEstateCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
  @@index([userId])
}

model CompanyDelistRequest {
  id              String   @id @default(cuid())
  companyId       String
  reason          String
  contactEmail    String
  contactPhone    String?
  details         String?  @db.Text
  status          String   @default("PENDING") // PENDING, PROCESSED, REJECTED
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  company         RealEstateCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
}



